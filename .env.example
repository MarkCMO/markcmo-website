# MarkCMO local test env
# Copy to .env (gitignored) and fill in. Do NOT commit .env.
# netlify dev auto-loads .env for local function runs.

# ─── WETYR Studios (script dissector) ───────────────────────────
GEMINI_API_KEY=
MISTRAL_API_KEY=
TMDB_API_KEY=

# ─── Document signing (Supabase + Resend) ───────────────────────
# Used by: submit-engagement-doc, execute-engagement-doc, get-document
# Supabase project: CLIPOS (saoomfwycegflxelggxv)
# Namespaced to avoid collision with existing SUPABASE_URL / SUPABASE_SERVICE_KEY
# which point at a different Supabase project used by other site systems.
MARKCMO_SUPABASE_URL=https://saoomfwycegflxelggxv.supabase.co
MARKCMO_SUPABASE_SERVICE_KEY=        # service-role key, NOT the anon key
RESEND_API_KEY=                      # Resend API key for transactional email
TOKEN_SECRET=                        # any random secret for HMAC signing

# ─── Engagement payment pipeline (Square) ──────────────────────
# Used by: square-invoice-action, square-webhook, engagement-payment-followups
# Square production credentials. Set SQUARE_ENV=sandbox to use sandbox API.
SQUARE_ACCESS_TOKEN=                 # production access token
SQUARE_LOCATION_ID=                  # WETYR Corporation location
SQUARE_ENV=production                # or sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=        # from Square Webhook Subscriptions

# ─── Calendly intake ───────────────────────────────────────────
# Used by: calendly-webhook
CALENDLY_SIGNING_KEY=                # from Calendly webhook subscription

# ─── Admin auth + API token ────────────────────────────────────
ADMIN_SESSION_SECRET=
MARKCMO_ADMIN_API_TOKEN=             # for server-to-server admin calls

# ─── Legacy signing (still used by /forms/proposal, NDA, MSA) ──
# Optional. If unset, the legacy flow falls back to email attachments.
JSONBIN_API_KEY=
JSONBIN_LINKS_BIN_ID=
