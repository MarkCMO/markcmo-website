<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>MarkCMO Academy - Elite Business Courses</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:ital,wght@0,300;0,400;0,600;0,700;0,900;1,400&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--black:#060606;--surface:#0e0e0e;--card:#141414;--border:#1e1e1e;--gold:#C9A84C;--gold-dim:rgba(201,168,76,0.15);--gold-glow:rgba(201,168,76,0.4);--text:#f0f0f0;--dim:#666;--red:#e05555;--green:#4CAF72}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--black);color:var(--text);font-family:'Barlow',sans-serif;font-size:15px;line-height:1.6}
a{color:inherit;text-decoration:none}

/* NAV */
.nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:16px 40px;display:flex;align-items:center;justify-content:space-between;background:rgba(6,6,6,0.92);backdrop-filter:blur(12px);border-bottom:1px solid rgba(201,168,76,0.1)}
.nav-logo{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:3px;color:var(--gold)}
.nav-links{display:flex;gap:28px;align-items:center;font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--dim)}
.nav-links a:hover{color:var(--gold)}
.nav-cta{background:var(--gold);color:#000;padding:8px 20px;font-size:11px;font-weight:900;letter-spacing:2px;text-transform:uppercase;transition:all 0.2s}
.nav-cta:hover{background:#fff;color:#000}
/* HERO */
.hero{min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:120px 40px 80px;position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 50% 0%,rgba(201,168,76,0.08) 0%,transparent 60%);pointer-events:none}
.hero-eyebrow{font-size:11px;font-weight:700;letter-spacing:4px;text-transform:uppercase;color:var(--gold);margin-bottom:24px;padding:6px 16px;border:1px solid rgba(201,168,76,0.3);display:inline-block}
.hero-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(60px,10vw,140px);line-height:0.9;letter-spacing:3px;margin-bottom:24px}
.hero-title span{color:var(--gold)}
.hero-sub{font-size:clamp(16px,2vw,22px);color:var(--dim);max-width:700px;line-height:1.7;margin:0 auto 40px}
.hero-stats{display:flex;gap:48px;justify-content:center;margin-bottom:48px;flex-wrap:wrap}
.hero-stat-val{font-family:'Bebas Neue',sans-serif;font-size:48px;color:var(--gold);display:block;line-height:1}
.hero-stat-label{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--dim);margin-top:4px}
.hero-btns{display:flex;gap:16px;flex-wrap:wrap;justify-content:center}
.btn-primary{background:var(--gold);color:#000;padding:14px 32px;font-size:12px;font-weight:900;letter-spacing:3px;text-transform:uppercase;transition:all 0.2s;display:inline-block}
.btn-primary:hover{background:#fff;transform:translateY(-2px)}
.btn-outline{border:1px solid rgba(201,168,76,0.4);color:var(--gold);padding:14px 32px;font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;transition:all 0.2s;display:inline-block}
.btn-outline:hover{border-color:var(--gold);background:var(--gold-dim)}
/* HOW IT WORKS */
.section{padding:100px 40px;max-width:1400px;margin:0 auto}
.section-label{font-size:10px;font-weight:700;letter-spacing:4px;text-transform:uppercase;color:var(--gold);margin-bottom:16px}
.section-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(40px,5vw,72px);letter-spacing:2px;line-height:1;margin-bottom:48px}
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:2px;margin-top:48px}
.step{background:var(--card);padding:32px;border:1px solid var(--border);position:relative;transition:border-color 0.2s}
.step:hover{border-color:var(--gold)}
.step-num{font-family:'Bebas Neue',sans-serif;font-size:64px;color:var(--border);line-height:1;position:absolute;top:16px;right:20px}
.step-icon{font-size:28px;margin-bottom:16px}
.step-title{font-size:16px;font-weight:700;color:var(--text);margin-bottom:8px}
.step-desc{font-size:13px;color:var(--dim);line-height:1.7}
.step-outcome-tag{margin-top:16px;font-size:11px;font-weight:700;letter-spacing:1.5px;color:var(--gold);font-family:'DM Mono',monospace;border-top:1px solid rgba(201,168,76,0.15);padding-top:12px}
.step-outcome .step-title{font-size:15px;font-weight:900;color:var(--text);letter-spacing:0;line-height:1.3;margin-bottom:10px}
.step-outcome .step-num{color:rgba(201,168,76,0.12)}
.step-outcome:hover .step-num{color:rgba(201,168,76,0.25)}
/* COURSES GRID */
.courses-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(380px,1fr));gap:2px;margin-top:48px}
.course-card{background:var(--card);border:1px solid var(--border);padding:32px;position:relative;transition:all 0.3s;display:flex;flex-direction:column}
.course-card:hover{border-color:var(--gold);background:#181818;transform:translateY(-2px)}
.course-badge{font-size:9px;font-weight:900;letter-spacing:3px;text-transform:uppercase;padding:4px 10px;background:var(--gold);color:#000;display:inline-block;margin-bottom:16px}
.course-icon{font-size:32px;margin-bottom:12px}
.course-title{font-family:'Bebas Neue',sans-serif;font-size:28px;letter-spacing:1px;color:var(--text);margin-bottom:8px;line-height:1.1}
.course-tagline{font-size:13px;color:var(--dim);margin-bottom:20px;line-height:1.5;font-style:italic}
.course-meta{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:20px}
.course-meta-item{font-size:11px;color:var(--dim);display:flex;align-items:center;gap:4px}
.course-meta-item span{color:var(--text);font-weight:600}
.course-modules-preview{border-top:1px solid var(--border);padding-top:16px;margin-bottom:20px}
.course-modules-label{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--dim);margin-bottom:8px}
.course-module-item{font-size:12px;color:var(--dim);padding:3px 0;display:flex;align-items:center;gap:6px}
.course-module-item::before{content:'→';color:var(--gold);font-size:10px}
.course-pricing{margin-top:auto;display:flex;align-items:baseline;gap:12px;margin-bottom:16px}
.course-price{font-family:'Bebas Neue',sans-serif;font-size:42px;color:var(--gold);letter-spacing:1px}
.course-retake{font-size:12px;color:var(--dim)}
.course-retake strong{color:var(--text)}
.course-cta{width:100%;background:var(--gold);color:#000;border:none;padding:14px;font-family:'Barlow',sans-serif;font-size:12px;font-weight:900;letter-spacing:3px;text-transform:uppercase;cursor:pointer;transition:all 0.2s;display:block;text-align:center}
.course-cta:hover{background:#fff}
.course-access-link{display:block;text-align:center;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--dim);margin-top:10px;padding:6px;border:1px solid var(--border);transition:all 0.2s;text-decoration:none;}
.course-access-link:hover{color:var(--gold);border-color:var(--gold);background:rgba(201,168,76,0.05);}
/* COMING SOON CARDS */
.course-card-soon{background:#111;border:1px solid #2a2a2a;padding:0;overflow:hidden;min-height:280px;display:flex;align-items:stretch;}
.course-card-soon:hover{border-color:#3a3a3a;transform:none;}
.course-soon-overlay{display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:32px 24px;width:100%;gap:10px;filter:none;}
.course-soon-badge{font-size:9px;font-weight:900;letter-spacing:4px;text-transform:uppercase;padding:4px 14px;border:1px solid #333;color:#444;display:inline-block;}
.course-soon-title{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:1px;color:#333;line-height:1.2;}
.course-soon-tagline{font-size:12px;color:#2a2a2a;font-style:italic;max-width:280px;line-height:1.5;}
.course-soon-meta{font-size:10px;color:#2a2a2a;letter-spacing:1px;}
.course-soon-notify{font-size:10px;color:#333;letter-spacing:2px;text-transform:uppercase;margin-top:8px;padding:8px 16px;border:1px solid #2a2a2a;cursor:default;}
/* WARNING BANNER */
.warning-banner{background:rgba(201,168,76,0.06);border:1px solid rgba(201,168,76,0.2);border-left:3px solid var(--gold);padding:24px 32px;margin-bottom:48px;display:flex;gap:16px;align-items:flex-start}
.warning-icon{font-size:24px;flex-shrink:0}
.warning-text h3{font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:1px;margin-bottom:6px}
.warning-text p{font-size:13px;color:var(--dim);line-height:1.7}
/* GRADING */
.grade-table{width:100%;border-collapse:collapse;margin-top:32px}
.grade-table th{text-align:left;padding:12px 16px;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--dim);border-bottom:1px solid var(--border)}
.grade-table td{padding:12px 16px;font-size:13px;border-bottom:1px solid rgba(255,255,255,0.04)}
.grade-table tr:hover td{background:rgba(201,168,76,0.03)}
.grade-a{color:#4CAF72;font-weight:700}
.grade-b{color:var(--gold);font-weight:700}
.grade-c{color:#e0a040;font-weight:700}
.grade-f{color:var(--red);font-weight:700}
/* GRAD PREVIEW */
.grad-preview{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:16px;margin-top:32px}
.grad-card{background:var(--card);border:1px solid var(--border);padding:20px;text-align:center;transition:border-color 0.2s}
.grad-card:hover{border-color:var(--gold)}
.grad-photo{width:72px;height:72px;border-radius:50%;background:var(--border);margin:0 auto 12px;overflow:hidden;border:2px solid var(--gold)}
.grad-photo img{width:100%;height:100%;object-fit:cover}
.grad-photo-placeholder{width:72px;height:72px;border-radius:50%;background:var(--gold-dim);border:2px solid rgba(201,168,76,0.3);display:flex;align-items:center;justify-content:center;font-size:24px;margin:0 auto 12px}
.grad-name{font-size:13px;font-weight:700;margin-bottom:4px}
.grad-course{font-size:11px;color:var(--dim)}
.grad-gpa{font-size:12px;color:var(--gold);font-family:'DM Mono',monospace;margin-top:4px}
/* DIPSLOMA PREVIEW */
.diploma-preview{background:var(--card);border:1px solid var(--gold);padding:48px;text-align:center;position:relative;max-width:700px;margin:48px auto 0}
.diploma-preview::before{content:'';position:absolute;inset:8px;border:1px solid rgba(201,168,76,0.2);pointer-events:none}
.diploma-seal{font-size:36px;margin-bottom:16px;color:var(--gold);letter-spacing:12px;display:block}
.diploma-from{font-size:11px;letter-spacing:4px;text-transform:uppercase;color:var(--dim);margin-bottom:16px}
.diploma-certifies{font-size:13px;color:var(--dim);margin-bottom:8px}
.diploma-name{font-family:'Bebas Neue',sans-serif;font-size:48px;color:var(--gold);letter-spacing:3px}
.diploma-completed{font-size:14px;color:var(--dim);margin:8px 0}
.diploma-course{font-size:20px;font-weight:700;margin-bottom:8px}
.diploma-gpa{font-size:13px;color:var(--dim);margin-bottom:24px}
.diploma-gpa strong{color:var(--gold);font-family:'DM Mono',monospace}
.diploma-footer{display:flex;justify-content:space-around;border-top:1px solid var(--border);padding-top:24px;margin-top:8px}
.diploma-sig{text-align:center}
.diploma-sig-name{font-size:14px;font-weight:700}
.diploma-sig-title{font-size:11px;color:var(--dim)}
/* FAQ */
.faq-item{border-bottom:1px solid var(--border);padding:20px 0}
.faq-q{font-size:15px;font-weight:700;cursor:pointer;display:flex;justify-content:space-between;align-items:center}
.faq-q:hover{color:var(--gold)}
.faq-chevron{transition:transform 0.2s;font-size:12px;color:var(--gold)}
.faq-a{font-size:13px;color:var(--dim);line-height:1.8;max-height:0;overflow:hidden;transition:max-height 0.3s ease,padding 0.2s}
.faq-item.open .faq-a{max-height:300px;padding-top:12px}
.faq-item.open .faq-chevron{transform:rotate(180deg)}
/* FOOTER */
.footer{border-top:1px solid var(--border);padding:48px 40px;text-align:center}
.footer-logo{font-family:'Bebas Neue',sans-serif;font-size:28px;letter-spacing:4px;color:var(--gold);margin-bottom:8px}
.footer-tagline{font-size:12px;color:var(--dim);margin-bottom:24px}
.footer-links{display:flex;gap:24px;justify-content:center;font-size:12px;color:var(--dim);flex-wrap:wrap}
.footer-links a:hover{color:var(--gold)}
/* SCROLL REVEAL */
.reveal{opacity:0;transform:translateY(20px);transition:opacity 0.6s,transform 0.6s}
.reveal.visible{opacity:1;transform:translateY(0)}
</style>
</head>
<body>


<!-- NAV -->
<nav class="nav">
  <div class="nav-logo">MarkCMO Academy</div>
  <div class="nav-links">
    <a href="#courses">Courses</a>
    <a href="#how">How It Works</a>
    <a href="#grading">Grading</a>
    <a href="/graduation">Graduates</a>
    <a href="/">← Main Site</a>
  </div>
  <a href="#courses" class="nav-cta">Start Learning</a>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-eyebrow">MarkCMO Academy - Est. 2026</div>
  <h1 class="hero-title">ELITE COURSES.<br><span>REAL RESULTS.</span><br>NO SHORTCUTS.</h1>
  <p class="hero-sub">The most rigorous executive education on the market. Built for operators who want to run at the top - not study their way to average. These courses are hard. They're supposed to be.</p>
  <div class="hero-stats">
    <div><span class="hero-stat-val">14</span><div class="hero-stat-label">Courses</div></div>
    <div><span class="hero-stat-val">600+</span><div class="hero-stat-label">Lessons</div></div>
    <div><span class="hero-stat-val">50Q</span><div class="hero-stat-label">Final Exam</div></div>
    <div><span class="hero-stat-val">4.0</span><div class="hero-stat-label">GPA Scale</div></div>
  </div>
  <div class="hero-btns">
    <a href="#courses" class="btn-primary">Browse All Courses</a>
    <a href="/graduation" class="btn-outline">View Graduates</a>
  </div>
</section>

<!-- HOW IT WORKS -->
<div style="max-width:1400px;margin:0 auto;padding:0 40px" id="how">
  <div class="reveal">
    <div class="section-label">The Process · What You Actually Get Out Of This</div>
    <div class="section-title">HOW IT WORKS</div>
    <p style="font-size:15px;color:var(--dim);max-width:700px;line-height:1.9;margin-bottom:0">Most courses teach you content. This teaches you how to operate. There's a difference between knowing a framework and being able to use it under pressure in front of a board. That's what this process is designed to produce.</p>
  </div>
  <div class="steps reveal">

    <div class="step step-outcome">
      <div class="step-num">01</div>
      <div class="step-icon">🔑</div>
      <div class="step-title">Start Immediately. Full Access.</div>
      <div class="step-desc">No waiting. No setup. You get immediate access to every lesson, framework, and exam in your course - study at your pace, revisit any lesson anytime, pick up exactly where you left off.</div>
      <div class="step-outcome-tag">→ Day one access. Study on your schedule.</div>
    </div>

    <div class="step step-outcome">
      <div class="step-num">02</div>
      <div class="step-icon">🧠</div>
      <div class="step-title">Learn How Executives Actually Think</div>
      <div class="step-desc">50+ lessons per course. Each one a 1,500+ word case-driven deep dive - real companies, real frameworks, real decisions. Not textbook theory. The exact mental models that executives use to run $50M-$500M organizations.</div>
      <div class="step-outcome-tag">→ You leave thinking differently. Permanently.</div>
    </div>

    <div class="step step-outcome">
      <div class="step-num">03</div>
      <div class="step-icon">⚡</div>
      <div class="step-title">No Moving Forward Until You Actually Know It</div>
      <div class="step-desc">5 rigorous questions after every lesson - written at the level of a live board debrief, not a textbook quiz. Score below 60% and you re-study before the next lesson unlocks. No skimming. No clicking through. You either know the material or you go back. This is how real competence is built.</div>
      <div class="step-outcome-tag">→ You don't just learn it - you can defend it in a boardroom.</div>
    </div>

    <div class="step step-outcome">
      <div class="step-num">04</div>
      <div class="step-icon">🏆</div>
      <div class="step-title">A Final Exam That Means Something</div>
      <div class="step-desc">50 questions across every module. 75% minimum to pass. Questions are scenario-based - the kind a CEO or board would actually ask you. First-time pass rate is below 50%. That's not a bug. That's the entire point.</div>
      <div class="step-outcome-tag">→ When you pass, you know you actually passed.</div>
    </div>

    <div class="step step-outcome" style="border-color:rgba(201,168,76,0.3);background:linear-gradient(135deg,#111 0%,#130f00 100%)">
      <div class="step-num">05</div>
      <div class="step-icon">🎓</div>
      <div class="step-title">Graduate as a Different Executive</div>
      <div class="step-desc">A numbered, verified diploma bearing your GPA designation - Summa, Magna, or Cum Laude. Your name on the MarkCMO Graduate Wall. A credential that belongs on your LinkedIn headline and in your client proposals. But more than any certificate: the frameworks, fluency, and demonstrated mastery to walk into any room and be the most qualified operator there.</div>
      <div class="step-outcome-tag" style="color:var(--gold)">→ This is the credential that opens rooms.</div>
    </div>

  </div>
</div>

<!-- CREDENTIAL BANNER -->
<div style="max-width:1400px;margin:60px auto;padding:0 40px">
  <div class="warning-banner reveal">
    <div class="warning-icon">🏆</div>
    <div class="warning-text">
      <h3>This Diploma Is Earned. Not Handed Out.</h3>
      <p>First-time exam pass rate is below 50%. Every retake uses a completely new question set - there is no memorizing your way through. Graduates of this program have gone on to command $150K-$300K+ fractional engagements, close Fortune 500 clients, and walk into any boardroom as the most credible operator in the room. That outcome starts with a credential that's actually hard to earn. This is it.</p>
    </div>
  </div>
</div>

<!-- TOP 5 FLAGSHIP COURSES -->
<div id="courses" style="max-width:1400px;margin:0 auto;padding:0 40px 60px">
  <div class="reveal">
    <div class="section-label">Top 5 Launch Courses · Highest Demand Roles</div>
    <div class="section-title">THE FLAGSHIP FIVE</div>
    <p style="font-size:15px;color:var(--dim);max-width:680px;line-height:1.8;margin:16px 0 0">Three flagship C-suite courses are live now. Complete, battle-tested, and ready to deploy. More courses launching soon - the complete executive stack is being built in public.</p>
  </div>
  <!-- Market demand stats bar -->
  <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:2px;margin:40px 0 0;background:var(--border)">
    <div style="background:var(--card);padding:20px 16px;text-align:center">
      <div style="font-size:22px;font-weight:900;color:var(--gold)">50K+</div>
      <div style="font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--dim);margin-top:4px">CFO Community</div>
    </div>
    <div style="background:var(--card);padding:20px 16px;text-align:center">
      <div style="font-size:22px;font-weight:900;color:var(--gold)">75K+</div>
      <div style="font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--dim);margin-top:4px">CMO Community</div>
    </div>
    <div style="background:var(--card);padding:20px 16px;text-align:center">
      <div style="font-size:22px;font-weight:900;color:var(--gold)">90K+</div>
      <div style="font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--dim);margin-top:4px">AE Community</div>
    </div>
    <div style="background:var(--card);padding:20px 16px;text-align:center">
      <div style="font-size:22px;font-weight:900;color:var(--gold)">140K+</div>
      <div style="font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--dim);margin-top:4px">Growth Community</div>
    </div>
    <div style="background:var(--card);padding:20px 16px;text-align:center">
      <div style="font-size:22px;font-weight:900;color:var(--gold)">60K+</div>
      <div style="font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--dim);margin-top:4px">VP Sales Community</div>
    </div>
  </div>
  <div class="courses-grid reveal" id="courses-grid-top5" style="margin-top:2px">
    <!-- JS rendered top 5 -->
  </div>
</div>

<!-- EXTENDED COURSE LIBRARY -->
<div style="max-width:1400px;margin:0 auto;padding:0 40px 100px">
  <div class="reveal" style="padding-top:60px;border-top:1px solid var(--border)">
    <div class="section-label">Extended Course Library</div>
    <div class="section-title">BUILD YOUR FULL STACK</div>
    <p style="font-size:15px;color:var(--dim);max-width:680px;line-height:1.8;margin:16px 0 0">Specialty and tactical courses - each earning a separate diploma. These are coming. Sign up now to be notified when each launches.</p>
  </div>
  <div class="courses-grid reveal" id="courses-grid-library" style="margin-top:48px">
    <!-- JS rendered library -->
  </div>
</div>

<!-- GRADING SYSTEM -->
<div id="grading" style="background:var(--surface);padding:100px 0">
  <div style="max-width:1000px;margin:0 auto;padding:0 40px">
    <div class="reveal">
      <div class="section-label">Academic Standards</div>
      <div class="section-title">GRADING SYSTEM</div>
      <p style="color:var(--dim);margin-bottom:32px">GPA is calculated from your average score across all lesson quizzes, module exams, and the final exam. To graduate, you need a minimum 2.0 GPA AND a passing final exam score.</p>
    </div>
    <table class="grade-table reveal">
      <thead><tr><th>Score</th><th>Letter</th><th>GPA Points</th><th>Designation</th></tr></thead>
      <tbody>
        <tr><td>93-100%</td><td class="grade-a">A</td><td>4.0</td><td>🏆 Summa Cum Laude</td></tr>
        <tr><td>90-92%</td><td class="grade-a">A−</td><td>3.7</td><td>🥇 Magna Cum Laude</td></tr>
        <tr><td>87-89%</td><td class="grade-b">B+</td><td>3.3</td><td>🥈 Cum Laude</td></tr>
        <tr><td>83-86%</td><td class="grade-b">B</td><td>3.0</td><td>✅ Pass with Distinction</td></tr>
        <tr><td>80-82%</td><td class="grade-b">B−</td><td>2.7</td><td>✅ Pass with Merit</td></tr>
        <tr><td>77-79%</td><td class="grade-c">C+</td><td>2.3</td><td>✅ Pass</td></tr>
        <tr><td>73-76%</td><td class="grade-c">C</td><td>2.0</td><td>✅ Pass (minimum GPA to graduate)</td></tr>
        <tr><td>70-72%</td><td class="grade-c">C−</td><td>1.7</td><td>⛔ No Diploma (must retake exam)</td></tr>
        <tr><td>&lt;70%</td><td class="grade-f">F</td><td>0.0</td><td>⛔ Fail - Retake Required</td></tr>
      </tbody>
    </table>
    <div style="background:var(--card);border:1px solid var(--border);padding:20px;margin-top:24px;font-size:13px;color:var(--dim)" class="reveal">
      <strong style="color:var(--text)">Retake Policy:</strong> Failed courses require a discounted retake fee (see individual course pricing). Retakes generate completely new lesson content and exam questions - there is no memorizing your way through this.
    </div>
  </div>
</div>

