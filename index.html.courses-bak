  coo:         {id:'coo',         tier:1, title:'Fractional COO Mastery',                           tagline:'Architect the systems that scale companies from chaos to exit.',                                                  badge:'ELITE COURSE',       icon:'⚙️',hours:80,difficulty:'Advanced',              modules:10,lessons:50},
  cmo:         {id:'cmo',         tier:1, title:'Fractional CMO Mastery',                           tagline:'Command revenue, own the market, build a $50M practice.',                                                       badge:'FLAGSHIP COURSE',    icon:'📣',hours:80,difficulty:'Advanced',              modules:10,lessons:50,  community:'75K+ LinkedIn'},
  ceo:         {id:'ceo',         tier:1, title:'CEO Mastery: Building & Leading a $50M Company',  tagline:'The complete operating system for CEOs - strategy, team, capital, and culture - to build to $50M and beyond.',  badge:'TOP OF THE CHAIN',   icon:'👑',hours:80,difficulty:'Advanced',              modules:10,lessons:50},
  vpsales:     {id:'vpsales',     tier:1, title:'VP of Sales Mastery',                              tagline:'Build revenue organizations that consistently exceed quota at every scale.',                                      badge:'REVENUE LEADER',     icon:'💼',hours:75,difficulty:'Advanced',              modules:10,lessons:50,  community:'60K+ LinkedIn'},
  growth:      {id:'growth',      tier:1, comingSoon:true, title:'Growth Manager Mastery',               tagline:'Build compounding growth systems. Take companies from $1M to $100M ARR.',                                       badge:'FASTEST GROWING',    icon:'📈',hours:45,difficulty:'Intermediate-Advanced',  modules:8, lessons:32, community:'140K+ Community'},
  ae:          {id:'ae',          tier:1, comingSoon:true, title:'Account Executive Excellence',          tagline:'Hit 150%+ of quota consistently. Build a $300K-500K sales career.',                                            badge:'LARGEST COMMUNITY',  icon:'🎯',hours:50,difficulty:'Intermediate-Advanced',  modules:8, lessons:32, community:'90K+ LinkedIn'},
  // ── SPECIALTY & TACTICAL ────────────────────────────────────────────────────
  revenue:     {id:'revenue',     tier:2, comingSoon:true, title:'Revenue Architecture & GTM',                       tagline:'Design the revenue machine that never stops compounding.',                                                       badge:'EXECUTIVE LEVEL',    icon:'💰',hours:70,difficulty:'Advanced',              modules:10,lessons:50},
  category:    {id:'category',    tier:2, comingSoon:true, title:'Category Design & Market Leadership',   tagline:"Don't compete for the market. Design one you own.",                                                             badge:'BREAKTHROUGH',       icon:'🏆',hours:45,difficulty:'Advanced',              modules:8, lessons:32},
  leadership:  {id:'leadership',  tier:2, comingSoon:true, title:'Executive Leadership for Consultants',  tagline:'Lead at the highest level. Command the room. Change companies.',                                                  badge:'LEADERSHIP MASTER',  icon:'🌟',hours:35,difficulty:'Advanced',              modules:8, lessons:32},
  digital:     {id:'digital',     tier:2, comingSoon:true, title:'Digital Marketing Mastery',             tagline:'Dominate every channel. Build systems that compound.',                                                           badge:'BESTSELLER',         icon:'🚀',hours:60,difficulty:'Intermediate-Advanced',  modules:10,lessons:40},
  b2bdemand:   {id:'b2bdemand',   tier:2, comingSoon:true, title:'B2B Demand Generation',                 tagline:'Build the pipeline machine that feeds sales forever.',                                                           badge:'SALES ACCELERATOR',  icon:'🎪',hours:45,difficulty:'Intermediate-Advanced',  modules:8, lessons:32},
  aimarketing: {id:'aimarketing', tier:2, comingSoon:true, title:'AI-Powered Marketing',                  tagline:'Harness AI to outmarket every competitor.',                                                                      badge:'FUTURE-PROOF',       icon:'🤖',hours:40,difficulty:'Intermediate',              modules:8, lessons:32},
  linkedin:    {id:'linkedin',    tier:2, comingSoon:true, title:'LinkedIn Growth Machine',               tagline:'Build authority. Generate leads. Close clients on LinkedIn.',                                                    badge:'HOT COURSE',         icon:'🔗',hours:35,difficulty:'Intermediate',              modules:8, lessons:32},
  instagram:   {id:'instagram',   tier:2, comingSoon:true, title:'Instagram for Business',                tagline:'Visual storytelling that turns followers into revenue.',                                                          badge:'TRENDING',           icon:'📸',hours:30,difficulty:'Beginner-Intermediate',  modules:8, lessons:32},
};

// ── Render Courses Grid ──────────────────────────────────────────────────────
const sampleModules = {
  cmo:['The CMO Mandate & Strategic Framework','Brand Architecture & Market Positioning','Revenue Attribution & Analytics','Demand Generation Architecture','Content Strategy & Thought Leadership'],
  coo:['Operations Architecture & Systems Thinking','Process Design & Operational Excellence','Technology Stack & Infrastructure','Financial Operations & BI','Team Structure, HR Ops & Talent Systems'],
  digital:['Digital Marketing Strategy','SEO Mastery','Paid Search & PPC','Social Media Marketing','Email Marketing & Automation'],
  linkedin:['LinkedIn Algorithm Mastery','Content Strategy for Authority','Thought Leadership & Personal Brand','Lead Generation Systems','LinkedIn Ads & Paid Strategy'],
  instagram:['Algorithm & Platform Strategy','Visual Branding & Aesthetic','Reels Strategy & Video Content','Community Building & Engagement','Instagram Shopping & eCommerce'],
  revenue:['Revenue Architecture Fundamentals','Go-To-Market Strategy Design','Pricing Strategy & Optimization','Sales Architecture & Pipeline','Demand Generation & Revenue Marketing'],
  category:['Category Design Fundamentals','Market Research & Discovery','Point of View Architecture','Category Evangelism & Conditioning','Competitive Moats & Dominance'],
  aimarketing:['AI Marketing Foundations','AI-Powered Content Creation','AI for SEO & Organic Growth','AI in Paid Media','Personalization & Customer Experience'],
  b2bdemand:['B2B Demand Generation Strategy','ABM at Scale','Content-Led Demand','Outbound Demand Generation','Events, Webinars & Community'],
  leadership:['Executive Presence & Leadership Identity','Strategic Communication','Decision Making & Strategic Thinking','Leadership in Consulting','Building High-Performance Teams'],
  cfo:['CFO Mandate & Strategic Finance Leadership','Accounting Systems & Financial Architecture','Cash Flow Management & Working Capital','Financial Modeling & Forecasting','Capital Structure & Fundraising','Investor Relations & Board Reporting','Risk Management & Internal Controls','M&A Due Diligence & Integration','Strategic Finance & Value Creation','CFO Leadership & Executive Presence'],
  ae:['Elite AE Mindset & Territory Planning','Prospecting & Pipeline Generation','Discovery Mastery & Qualification','Solution Selling & Demonstrations','Proposal, Negotiation & Deal Architecture','Closing Strategies & Deal Velocity','Account Management & Expansion Revenue','Sales Technology & Performance Analytics'],
  growth:['Growth Foundations & Operating System','Acquisition Channel Strategy','Activation & Onboarding Optimization','Retention & Churn Reduction','Revenue Expansion & Monetization','Viral Growth & Referral Systems','Growth Analytics & Experimentation','Scaling Growth & Growth Leadership'],
  vpsales:['VP of Sales Operating System','Building the Sales Team','Sales Process Design & Methodology','Pipeline Management & Revenue Forecasting','Sales Compensation & Incentive Design','Sales Enablement & Continuous Training','Territory Segmentation & Account Strategy','Revenue Operations & Sales Analytics','Enterprise & Strategic Selling','VP of Sales Leadership & Career'],
};

function courseCard(c, featured) {
  const communityBadge = c.community ? `<div class="course-community">${c.community}</div>` : '';

  if (c.comingSoon) {
    return `
    <div class="course-card course-card-soon">
      <div class="course-soon-overlay">
        <div class="course-soon-badge">COMING SOON</div>
        <div class="course-soon-title">${c.icon} ${c.title}</div>
        <div class="course-soon-tagline">"${c.tagline}"</div>
        <div class="course-soon-meta">${c.modules} Modules · ${c.lessons} Lessons · ${c.hours}h Study</div>
        <div class="course-soon-notify">🔔 Notify me when available</div>
      </div>
    </div>`;
  }

  const featuredClass = featured ? ' course-card-featured' : '';
  return `
    <div class="course-card${featuredClass}">
      ${featured ? '<div class="course-featured-ribbon">LIVE NOW</div>' : ''}
      <div class="course-badge">${c.badge}</div>
      <div class="course-icon">${c.icon}</div>
      <div class="course-title">${c.title}</div>
      <div class="course-tagline">"${c.tagline}"</div>
      ${communityBadge}
      <div class="course-meta">
        <div class="course-meta-item">📚 <span>${c.modules}</span> Modules</div>
        <div class="course-meta-item">📝 <span>${c.lessons}</span> Lessons</div>
        <div class="course-meta-item">⏱ <span>${c.hours}h</span> Study</div>
        <div class="course-meta-item">📊 <span>${c.difficulty}</span></div>
      </div>
      <div class="course-modules-preview">
        <div class="course-modules-label">Sample Modules</div>
        ${(sampleModules[c.id]||[]).slice(0,4).map(m=>`<div class="course-module-item">${m}</div>`).join('')}
      </div>
      <a href="/learn?course=${c.id}" class="course-cta">Start Course →</a>
    </div>
  `;
}

function renderCourses(){
  const top5 = document.getElementById('courses-grid-top5');
  const library = document.getElementById('courses-grid-library');
  const all = Object.values(COURSES);
  const live1 = all.filter(c=>c.tier===1 && !c.comingSoon);
  const soon1 = all.filter(c=>c.tier===1 && c.comingSoon);
  const live2 = all.filter(c=>c.tier===2 && !c.comingSoon);
  const soon2 = all.filter(c=>c.tier===2 && c.comingSoon);
  top5.innerHTML    = live1.map(c=>courseCard(c, true)).join('') + soon1.map(c=>courseCard(c, false)).join('');
  library.innerHTML = live2.map(c=>courseCard(c, false)).join('') + soon2.map(c=>courseCard(c, false)).join('');
}

// ── FAQ ───────────────────────────────────────────────────────────────────────
function toggleFaq(el){
  el.parentElement.classList.toggle('open');
}

// ── Scroll Reveal ─────────────────────────────────────────────────────────────
function initReveal(){
  const els = document.querySelectorAll('.reveal');
  const obs = new IntersectionObserver(entries=>{
    entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');obs.unobserve(e.target);}});
  },{threshold:0.1});
  els.forEach(el=>obs.observe(el));
}

// ── Load Graduates Preview ────────────────────────────────────────────────────
async function loadGradsPreview(){
  try{
    const r = await fetch('/.netlify/functions/course-graduate');
    if(!r.ok) return;
    const data = await r.json();
    const grads = (data.graduates||[]).slice(0,8);
    if(!grads.length) return;
    const grid = document.getElementById('grad-preview-grid');
    grid.innerHTML = grads.map(g=>`
      <div class="grad-card">
        ${g.photo?`<div class="grad-photo"><img src="${g.photo}" alt="${g.name}" /></div>`:`<div class="grad-photo-placeholder">🎓</div>`}
        <div class="grad-name">${g.name}</div>
        <div class="grad-course">${g.courseTitle||g.course}</div>
        <div class="grad-gpa">GPA: ${g.gpa} (${g.grade})</div>
      </div>
    `).join('');
  }catch(e){}
}

renderCourses();
initReveal();
loadGradsPreview();

function trackEnroll(courseId) {
  // Store course interest for post-payment welcome
  localStorage.setItem('mcademy_last_course', courseId);
}
</script>

</body>
</html>
