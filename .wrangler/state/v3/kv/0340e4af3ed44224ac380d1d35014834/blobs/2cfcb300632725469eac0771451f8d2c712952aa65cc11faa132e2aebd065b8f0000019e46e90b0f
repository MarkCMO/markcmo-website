<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/webp" href="/favicon.webp"><link rel="apple-touch-icon" href="/mark-photo.webp">
<meta name="robots" content="noindex, follow">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mark Louis Gabrielli Jr. - CMO Blueprint</title>
<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:ital,wght@0,400;0,500;0,600;0,700;0,800&family=DM+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:ital,wght@0,400;0,500;0,600;0,700;0,800&family=DM+Mono:wght@400;500&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:ital,wght@0,400;0,500;0,600;0,700;0,800&family=DM+Mono:wght@400;500&display=swap"></noscript>
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --bg:#0a1628;
  --bg-light:#0d1d35;
  --text:#e8f0ff;
  --text-dim:rgba(232,240,255,.5);
  --text-faint:rgba(232,240,255,.25);
  --cyan:#00d4ff;
  --cyan-glow:rgba(0,212,255,.15);
  --cyan-dim:rgba(0,212,255,.4);
  --orange:#ff6b35;
  --orange-glow:rgba(255,107,53,.12);
  --green:#34d399;
  --grid:rgba(232,240,255,.07);
  --grid-strong:rgba(232,240,255,.12);
  --border:rgba(232,240,255,.15);
  --border-bright:rgba(232,240,255,.3);
}
html{font-size:16px;scroll-behavior:smooth}
body{
  font-family:'IBM Plex Mono',monospace;
  background:var(--bg);
  color:var(--text);
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
  position:relative;
}
::selection{background:rgba(0,212,255,.3)}
a{color:inherit;text-decoration:none}
/* BLUEPRINT GRID OVERLAY */
body::before{
  content:'';
  position:fixed;
  inset:0;
  z-index:0;
  pointer-events:none;
  background:
    repeating-linear-gradient(0deg,transparent,transparent 49px,var(--grid) 49px,var(--grid) 50px),
    repeating-linear-gradient(90deg,transparent,transparent 49px,var(--grid) 49px,var(--grid) 50px),
    repeating-linear-gradient(0deg,transparent,transparent 199px,var(--grid-strong) 199px,var(--grid-strong) 200px),
    repeating-linear-gradient(90deg,transparent,transparent 199px,var(--grid-strong) 199px,var(--grid-strong) 200px);
}
/* LIGHT LEAK */
body::after{
  content:'';
  position:fixed;
  inset:0;
  z-index:0;
  pointer-events:none;
  background:
    radial-gradient(ellipse at 0% 0%, rgba(0,212,255,.06) 0%, transparent 50%),
    radial-gradient(ellipse at 100% 100%, rgba(0,212,255,.04) 0%, transparent 50%),
    radial-gradient(ellipse at 50% 0%, rgba(255,107,53,.03) 0%, transparent 40%);
}
/* FOLD MARKS & CROP MARKS */
.fold-marks{
  position:fixed;inset:0;z-index:1000;pointer-events:none;
}
.fold-marks::before{
  content:'';position:fixed;
  top:50%;left:0;width:20px;height:1px;
  background:var(--text-faint);
}
.fold-marks::after{
  content:'';position:fixed;
  top:50%;right:0;width:20px;height:1px;
  background:var(--text-faint);
}
.crop-tl,.crop-tr,.crop-bl,.crop-br{position:fixed;z-index:1000;pointer-events:none;}
.crop-tl{top:10px;left:10px;}
.crop-tl::before{content:'';position:absolute;top:0;left:0;width:1px;height:15px;background:var(--text-faint);}
.crop-tl::after{content:'';position:absolute;top:0;left:0;width:15px;height:1px;background:var(--text-faint);}
.crop-tr{top:10px;right:10px;}
.crop-tr::before{content:'';position:absolute;top:0;right:0;width:1px;height:15px;background:var(--text-faint);}
.crop-tr::after{content:'';position:absolute;top:0;right:0;width:15px;height:1px;background:var(--text-faint);}
.crop-bl{bottom:10px;left:10px;}
.crop-bl::before{content:'';position:absolute;bottom:0;left:0;width:1px;height:15px;background:var(--text-faint);}
.crop-bl::after{content:'';position:absolute;bottom:0;left:0;width:15px;height:1px;background:var(--text-faint);}
.crop-br{bottom:10px;right:10px;}
.crop-br::before{content:'';position:absolute;bottom:0;right:0;width:1px;height:15px;background:var(--text-faint);}
.crop-br::after{content:'';position:absolute;bottom:0;right:0;width:15px;height:1px;background:var(--text-faint);}
/* CENTER MARKS */
.center-top{position:fixed;top:0;left:50%;width:1px;height:15px;background:var(--text-faint);z-index:1000;pointer-events:none;transform:translateX(-50%);}
.center-bottom{position:fixed;bottom:0;left:50%;width:1px;height:15px;background:var(--text-faint);z-index:1000;pointer-events:none;transform:translateX(-50%);}
/* LAYOUT */
.wrap{max-width:1100px;margin:0 auto;padding:0 40px;position:relative;z-index:1}
/* NAV */
.nav{
  position:fixed;top:0;left:0;right:0;z-index:100;
  background:rgba(10,22,40,.92);
  backdrop-filter:blur(20px);
  border-bottom:1px solid var(--border);
}
.nav-inner{
  max-width:1100px;margin:0 auto;padding:10px 40px;
  display:flex;justify-content:space-between;align-items:center;
}
.nav-mark{
  font-family:'Rajdhani',sans-serif;
  font-weight:700;font-size:1rem;
  letter-spacing:.15em;text-transform:uppercase;
  color:var(--cyan);
  text-shadow:0 0 10px rgba(0,212,255,.4);
}
.nav-links{display:flex;gap:24px;list-style:none}
.nav-links a{
  font-size:.65rem;font-weight:500;
  color:var(--text-dim);letter-spacing:.1em;
  text-transform:uppercase;
  transition:all .2s;
}
.nav-links a:hover{color:var(--cyan);text-shadow:0 0 8px rgba(0,212,255,.3)}
.nav-btns{display:flex;gap:8px}
.nbtn{
  font-family:'IBM Plex Mono',monospace;
  font-size:.65rem;font-weight:600;
  padding:7px 18px;
  border:1px solid var(--border);
  background:transparent;
  color:var(--text);
  cursor:pointer;
  transition:all .25s;
  letter-spacing:.06em;
  text-transform:uppercase;
  text-decoration:none;
  display:inline-flex;align-items:center;
}
.nbtn:hover{
  border-color:var(--cyan);
  color:var(--cyan);
  box-shadow:0 0 12px rgba(0,212,255,.15);
  text-shadow:0 0 6px rgba(0,212,255,.3);
}
.nbtn-fill{
  background:var(--cyan);
  color:var(--bg);
  border-color:var(--cyan);
}
.nbtn-fill:hover{
  background:#33ddff;
  box-shadow:0 0 20px rgba(0,212,255,.4);
  color:var(--bg);
}
/* TEXT GLOW */
.glow{text-shadow:0 0 10px rgba(0,212,255,.4),0 0 30px rgba(0,212,255,.15)}
.glow-orange{text-shadow:0 0 10px rgba(255,107,53,.5),0 0 30px rgba(255,107,53,.2)}
.glow-subtle{text-shadow:0 0 8px rgba(232,240,255,.2)}
/* TITLE BLOCK (architectural drawing style) */
.title-block{
  position:relative;
  margin-top:100px;
  margin-bottom:60px;
  display:grid;
  grid-template-columns:1fr auto;
  gap:0;
  min-height:400px;
}
.title-block-main{
  padding:40px 0;
  display:flex;
  flex-direction:column;
  justify-content:flex-end;
}
.title-block-info{
  border:2px solid var(--border-bright);
  padding:0;
  width:320px;
  align-self:flex-end;
}
.title-block-info .tbi-row{
  display:flex;
  border-bottom:1px solid var(--border);
  font-size:.65rem;
}
.title-block-info .tbi-row:last-child{border-bottom:none}
.title-block-info .tbi-label{
  padding:8px 12px;
  color:var(--text-dim);
  letter-spacing:.08em;
  text-transform:uppercase;
  width:120px;
  border-right:1px solid var(--border);
  flex-shrink:0;
}
.title-block-info .tbi-val{
  padding:8px 12px;
  color:var(--text);
  font-weight:500;
  flex:1;
}
.title-block-info .tbi-header{
  background:rgba(0,212,255,.06);
  border-bottom:2px solid var(--border-bright);
  padding:12px;
  text-align:center;
  font-family:'Rajdhani',sans-serif;
  font-size:.7rem;
  font-weight:600;
  letter-spacing:.2em;
  text-transform:uppercase;
  color:var(--cyan);
}
.hero-label{
  font-size:.6rem;font-weight:500;
  letter-spacing:.25em;text-transform:uppercase;
  color:var(--cyan);
  margin-bottom:20px;
  display:flex;align-items:center;gap:10px;
}
.hero-label::before{
  content:'';width:40px;height:1px;background:var(--cyan);
}
.hero-name{
  font-family:'Rajdhani',sans-serif;
  font-size:clamp(2.5rem,5.5vw,4.2rem);
  font-weight:700;
  line-height:1;
  letter-spacing:-.02em;
  margin-bottom:12px;
  text-shadow:0 0 20px rgba(0,212,255,.3),0 0 60px rgba(0,212,255,.1);
}
.hero-name .cyan{color:var(--cyan)}
.hero-role{
  font-size:.85rem;
  color:var(--text-dim);
  font-weight:400;
  margin-bottom:24px;
  letter-spacing:.05em;
}
.hero-role .sep{
  display:inline-block;
  width:20px;height:1px;
  background:var(--cyan-dim);
  margin:0 10px;
  vertical-align:middle;
}
.hero-contact{
  display:flex;gap:24px;flex-wrap:wrap;
  margin-bottom:40px;
}
.hc-item{
  font-size:.72rem;color:var(--text-dim);
  transition:all .2s;
  letter-spacing:.03em;
}
.hc-item:hover{color:var(--cyan);text-shadow:0 0 8px rgba(0,212,255,.3)}
/* DIMENSION CALLOUT STATS */
.stats{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:20px;
  margin-top:20px;
}
.dim-stat{
  position:relative;
  text-align:center;
  padding:30px 10px 20px;
}
.dim-stat::before{
  content:'';position:absolute;
  top:0;left:15%;right:15%;
  height:0;
  border-top:1px solid var(--orange);
}
.dim-stat::after{
  content:'';position:absolute;
  top:-4px;left:15%;
  width:0;height:0;
  border-right:5px solid var(--orange);
  border-top:3px solid transparent;
  border-bottom:3px solid transparent;
}
.dim-stat .dim-arrow-r{
  position:absolute;
  top:-4px;right:15%;
  width:0;height:0;
  border-left:5px solid var(--orange);
  border-top:3px solid transparent;
  border-bottom:3px solid transparent;
}
.dim-stat .dim-line-l,.dim-stat .dim-line-r{
  position:absolute;top:-8px;width:1px;height:16px;background:var(--orange);
}
.dim-stat .dim-line-l{left:15%}
.dim-stat .dim-line-r{right:15%}
.dim-val{
  font-family:'Rajdhani',sans-serif;
  font-size:2rem;font-weight:700;
  color:var(--orange);
  line-height:1;margin-bottom:6px;
  text-shadow:0 0 12px rgba(255,107,53,.4);
}
.dim-label{
  font-size:.55rem;font-weight:500;
  letter-spacing:.15em;text-transform:uppercase;
  color:var(--text-dim);
}
.dim-val[data-counter]{
  transition:all .3s;
}
/* SECTIONS */
.sec{
  padding:70px 0;
  position:relative;
  opacity:0;transform:translateY(20px);
  transition:all .6s cubic-bezier(.16,1,.3,1);
}
.sec.vis{opacity:1;transform:none}
.sec-head{
  display:flex;align-items:center;gap:14px;
  margin-bottom:36px;
  position:relative;
}
.sec-num{
  font-size:.55rem;font-weight:600;
  color:var(--orange);
  letter-spacing:.1em;
  padding:4px 8px;
  border:1px solid rgba(255,107,53,.3);
}
.sec-title{
  font-family:'Rajdhani',sans-serif;
  font-size:1.5rem;font-weight:600;
  letter-spacing:.05em;
  text-transform:uppercase;
  text-shadow:0 0 10px rgba(232,240,255,.15);
}
.sec-line{
  flex:1;height:0;
  border-top:1px dashed var(--border);
}
/* ANNOTATION BOX (Executive Summary) */
.annotation-box{
  position:relative;
  border:1px solid var(--border-bright);
  border-radius:4px;
  padding:30px;
  background:rgba(0,212,255,.02);
}
.annotation-box::before{
  content:'';position:absolute;
  top:-30px;left:60px;
  width:1px;height:30px;
  background:var(--cyan-dim);
}
.annotation-box::after{
  content:'';position:absolute;
  top:-34px;left:57px;
  width:7px;height:7px;
  border-radius:50%;
  border:1px solid var(--cyan);
  background:var(--bg);
}
.annotation-box .ann-label{
  position:absolute;
  top:-12px;left:20px;
  background:var(--bg);
  padding:0 10px;
  font-size:.55rem;
  letter-spacing:.15em;
  text-transform:uppercase;
  color:var(--cyan);
}
.annotation-box p{
  font-size:.85rem;line-height:1.85;
  color:rgba(232,240,255,.8);
}
.annotation-box em{
  font-style:normal;color:var(--cyan);font-weight:500;
  text-shadow:0 0 6px rgba(0,212,255,.2);
}
/* COMPETENCIES - Circuit Diagram Nodes */
.circuit-board{
  display:flex;flex-wrap:wrap;gap:0;
  justify-content:center;
  position:relative;
  padding:20px 0;
}
.circuit-node{
  position:relative;
  display:inline-flex;align-items:center;gap:8px;
  padding:10px 18px;
  margin:6px;
  border:1px solid var(--border);
  font-size:.7rem;
  color:var(--text-dim);
  letter-spacing:.04em;
  transition:all .3s;
  cursor:default;
  background:rgba(10,22,40,.8);
}
.circuit-node::before{
  content:'';
  width:6px;height:6px;
  border-radius:50%;
  background:var(--cyan-dim);
  flex-shrink:0;
  transition:all .3s;
}
.circuit-node:hover{
  border-color:var(--cyan);
  color:var(--cyan);
  text-shadow:0 0 8px rgba(0,212,255,.3);
  box-shadow:0 0 15px rgba(0,212,255,.1);
}
.circuit-node:hover::before{
  background:var(--cyan);
  box-shadow:0 0 8px var(--cyan);
}
/* Connector lines between nodes */
.circuit-connector{
  display:none;/* visual only through gap styling */
}
/* EXPERIENCE TIMELINE - Technical Measurement */
.tech-timeline{
  position:relative;
  padding-left:40px;
}
.tech-timeline::before{
  content:'';position:absolute;
  left:12px;top:0;bottom:0;
  width:0;
  border-left:2px solid var(--border-bright);
}
/* Measurement ticks */
.tech-timeline::after{
  content:'';position:absolute;
  left:2px;top:0;bottom:0;
  width:22px;
  background:repeating-linear-gradient(
    180deg,
    transparent 0px, transparent 48px,
    var(--border) 48px, var(--border) 50px
  );
}
.tl-item{
  position:relative;
  margin-bottom:30px;
  padding:24px 28px;
  border:1px solid var(--border);
  background:rgba(10,22,40,.6);
  transition:all .3s;
}
.tl-item:last-child{margin-bottom:0}
.tl-item:hover{
  border-color:var(--cyan-dim);
  background:rgba(0,212,255,.03);
  box-shadow:0 0 20px rgba(0,212,255,.05);
}
.tl-item::before{
  content:'';position:absolute;
  left:-32px;top:32px;
  width:10px;height:10px;
  background:var(--bg);
  border:2px solid var(--cyan);
  z-index:2;
  transition:all .3s;
}
.tl-item:first-child::before{
  background:var(--cyan);
  box-shadow:0 0 10px rgba(0,212,255,.5);
}
.tl-item:hover::before{
  background:var(--cyan);
  box-shadow:0 0 10px rgba(0,212,255,.5);
}
.tl-top{
  display:flex;justify-content:space-between;
  align-items:baseline;gap:16px;
  margin-bottom:4px;
}
.tl-role{
  font-family:'Rajdhani',sans-serif;
  font-size:1.1rem;font-weight:600;
  letter-spacing:.02em;
  text-shadow:0 0 6px rgba(232,240,255,.15);
}
.tl-dates{
  font-size:.65rem;color:var(--orange);
  letter-spacing:.08em;
  white-space:nowrap;
  padding:3px 8px;
  border:1px solid rgba(255,107,53,.3);
}
.tl-org{font-size:.78rem;color:var(--text-dim);margin-bottom:4px}
.tl-desc{font-size:.7rem;color:var(--text-faint);font-style:italic;margin-bottom:14px}
.tl-bullets{list-style:none}
.tl-bullets li{
  font-size:.78rem;line-height:1.7;
  color:rgba(232,240,255,.65);
  padding-left:18px;position:relative;
  margin-bottom:6px;
}
.tl-bullets li::before{
  content:'';position:absolute;left:0;top:9px;
  width:6px;height:1px;
  background:var(--cyan-dim);
}
.tl-bullets .hi{color:var(--cyan);font-weight:500}
/* REVENUE DASHBOARD - Oscilloscope Style */
.scope-panel{
  border:2px solid var(--border-bright);
  background:rgba(10,22,40,.8);
  position:relative;
}
.scope-header{
  display:flex;justify-content:space-between;align-items:center;
  padding:16px 24px;
  border-bottom:1px solid var(--border);
}
.scope-label{
  font-size:.55rem;letter-spacing:.2em;
  text-transform:uppercase;color:var(--text-dim);
}
.scope-live{
  display:flex;align-items:center;gap:6px;
  font-size:.55rem;color:var(--green);
  letter-spacing:.1em;
}
.scope-live .pulse{
  width:6px;height:6px;border-radius:50%;
  background:var(--green);
  animation:gPulse 2s infinite;
}
@keyframes gPulse{0%,100%{opacity:1;box-shadow:0 0 0 0 rgba(52,211,153,.4)}50%{opacity:.6;box-shadow:0 0 0 6px rgba(52,211,153,0)}}
.scope-body{padding:24px}
.scope-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:24px}
.scope-metric{
  border:1px solid var(--border);
  padding:18px 14px;
  background:rgba(0,212,255,.02);
}
.scope-metric-label{
  font-size:.5rem;letter-spacing:.15em;
  text-transform:uppercase;color:var(--text-faint);
  margin-bottom:8px;
}
.scope-metric-val{
  font-family:'Rajdhani',sans-serif;
  font-size:1.7rem;font-weight:700;
  color:var(--cyan);
  text-shadow:0 0 12px rgba(0,212,255,.4);
}
.scope-metric-sub{font-size:.6rem;color:var(--text-faint);margin-top:4px}
.scope-chart{
  position:relative;
  height:140px;
  margin-bottom:14px;
  border:1px solid var(--border);
  background:rgba(0,0,0,.2);
  overflow:hidden;
}
/* Oscilloscope grid inside chart */
.scope-chart::before{
  content:'';position:absolute;inset:0;
  background:
    repeating-linear-gradient(0deg,transparent,transparent 27px,rgba(0,212,255,.06) 27px,rgba(0,212,255,.06) 28px),
    repeating-linear-gradient(90deg,transparent,transparent 49px,rgba(0,212,255,.06) 49px,rgba(0,212,255,.06) 50px);
  pointer-events:none;
}
.scope-chart svg{width:100%;height:100%;position:relative;z-index:1}
.scope-chart .trace{
  fill:none;stroke:var(--cyan);stroke-width:2.5;
  stroke-linecap:round;stroke-linejoin:round;
  filter:drop-shadow(0 0 4px rgba(0,212,255,.6));
}
.scope-chart .trace-fill{fill:url(#scopeGrad)}
.scope-x{
  display:flex;justify-content:space-between;
  font-size:.5rem;color:var(--text-faint);
  letter-spacing:.05em;
}
/* DEAL SHEET - Engineering Spec Boxes */
.spec-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.spec-box{
  border:2px solid var(--border-bright);
  position:relative;
}
.spec-box .spec-header{
  background:rgba(255,107,53,.05);
  border-bottom:2px solid var(--border-bright);
  padding:12px 16px;
  display:flex;justify-content:space-between;align-items:center;
}
.spec-box .spec-type{
  font-size:.55rem;letter-spacing:.2em;
  text-transform:uppercase;
  color:var(--orange);
}
.spec-box .spec-dwg{
  font-size:.5rem;color:var(--text-faint);
  letter-spacing:.08em;
}
.spec-box h4{
  font-family:'Rajdhani',sans-serif;
  font-size:1rem;font-weight:600;
  padding:14px 16px 0;
  letter-spacing:.02em;
}
.spec-rows{padding:10px 16px 16px}
.spec-row{
  display:flex;justify-content:space-between;
  font-size:.72rem;padding:7px 0;
  border-bottom:1px dashed var(--border);
}
.spec-row:last-child{border:none}
.spec-row span:first-child{color:var(--text-faint);text-transform:uppercase;font-size:.6rem;letter-spacing:.08em}
.spec-row span:last-child{color:var(--text);font-weight:500}
/* CASE STUDIES - Cross Section Views */
.case-list{display:grid;gap:12px}
.case-item{
  display:flex;justify-content:space-between;align-items:center;
  gap:24px;padding:20px 24px;
  border:1px solid var(--border);
  background:rgba(10,22,40,.6);
