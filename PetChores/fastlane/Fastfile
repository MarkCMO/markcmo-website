# Pet Chores release automation (run on a Mac with Xcode + fastlane installed).
#
# Authentication uses an App Store Connect API key (.p8). Create one at
# App Store Connect -> Users and Access -> Integrations -> App Store Connect API.
# Keep the .p8 file OFF git. Provide these env vars before running a lane:
#   ASC_KEY_ID      the key id, e.g. ABC123XYZ
#   ASC_ISSUER_ID   the issuer id (a UUID shown on the same page)
#   ASC_KEY_PATH    absolute path to AuthKey_ABC123XYZ.p8 on your Mac
#
# One-time prep on the Mac:
#   brew install fastlane xcodegen
#   cd PetChores && xcodegen generate   (creates PetChores.xcodeproj)
#   open the project once, set your signing Team, add the In-App Purchase capability.
#
# Then:
#   fastlane meta      push listing text + screenshots only (no build)
#   fastlane beta      build, sign, upload to TestFlight
#   fastlane release   build, sign, upload, set metadata, submit for review

default_platform(:ios)

require "net/http"
require "json"

APP_STORE_APP_ID = "6779748088".freeze

# Raw App Store Connect REST helpers, for the listing fields fastlane's high-level
# actions do not manage (App Privacy nutrition labels, age rating, category, IAP v2).
def asc_jwt
  require "spaceship"
  token = Spaceship::ConnectAPI::Token.from(
    hash: {
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key: File.read(ENV["ASC_KEY_PATH"])
    }
  )
  token.text
end

def asc_request(method, path, jwt, body = nil)
  uri = URI("https://api.appstoreconnect.apple.com#{path}")
  http = Net::HTTP.new(uri.host, 443)
  http.use_ssl = true
  klass = { get: Net::HTTP::Get, post: Net::HTTP::Post,
            patch: Net::HTTP::Patch, delete: Net::HTTP::Delete }[method]
  req = klass.new(uri)
  req["Authorization"] = "Bearer #{jwt}"
  req["Content-Type"] = "application/json"
  req.body = body.to_json if body
  res = http.request(req)
  parsed = (JSON.parse(res.body) rescue res.body)
  [res.code.to_i, parsed]
end

platform :ios do
  before_all do
    # On CI, create and unlock a dedicated temporary keychain and configure its
    # partition list, so codesign never blocks on a GUI keychain-access prompt
    # (which hangs the headless runner). No-op on a developer's own machine.
    setup_ci
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
      in_house: false
    )
  end

  desc "Regenerate the Xcode project from project.yml"
  lane :gen do
    sh("cd .. && xcodegen generate")
  end

  desc "One-time: create the app record on App Store Connect"
  lane :setup_app do
    # produce(...) only supports legacy Apple ID (username) login and cannot use an
    # App Store Connect API key, so it fails in headless CI. Create the records
    # directly through Spaceship::ConnectAPI instead (same token path as create_iap).
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(
      hash: {
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key: File.read(ENV["ASC_KEY_PATH"])
      }
    )

    identifier = "com.petchores.app"

    existing = Spaceship::ConnectAPI::App.find(identifier)
    if existing
      UI.success("App already exists on App Store Connect: #{identifier} (id #{existing.id})")
      next
    end

    bundle = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == identifier }
    if bundle.nil?
      bundle = Spaceship::ConnectAPI::BundleId.create(name: "Pet Chores", identifier: identifier)
      UI.success("Registered bundle id #{identifier}")
    else
      UI.success("Bundle id already registered: #{identifier}")
    end

    # The App Store Connect API does not permit creating the initial app record
    # ('apps' resource disallows CREATE). It must be created once in the App Store
    # Connect website. Everything else (IAP, build, TestFlight, metadata) then runs
    # through the API key. Fail loudly with instructions instead of erroring opaquely.
    UI.user_error!(
      "App record for #{identifier} does not exist yet. Create it once at " \
      "https://appstoreconnect.apple.com -> Apps -> New App: Platform iOS, name " \
      "'Pet Chores: Pet Care Practice', primary language English (U.S.), bundle id " \
      "#{identifier}, SKU petchores-001. Then re-run a lane (create_iap or beta)."
    )
  end

  desc "One-time best-effort: create the non-consumable IAP. If it errors, create it " \
       "manually in App Store Connect (Monetization -> In-App Purchases) with product " \
       "id petchores.unlock.full, type Non-Consumable, Family Sharing ON, price ~4.99."
  lane :create_iap do
    begin
      require "spaceship"
      Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(
        hash: {
          key_id: ENV["ASC_KEY_ID"],
          issuer_id: ENV["ASC_ISSUER_ID"],
          key: File.read(ENV["ASC_KEY_PATH"])
        }
      )
      app = Spaceship::ConnectAPI::App.find("com.petchores.app")
      raise "App record not found; run `fastlane setup_app` first." unless app

      existing = app.get_in_app_purchases.find { |p| p.product_id == "petchores.unlock.full" }
      if existing
        UI.success("IAP already exists: petchores.unlock.full")
      else
        app.create_in_app_purchase(
          name: "Pet Chores Full Unlock",
          product_id: "petchores.unlock.full",
          in_app_purchase_type: "NON_CONSUMABLE",
          family_sharable: true,
          review_note: "Unlocks all pets, multiple pets at once, photo proof, and report export. Reachable only inside PIN-gated Parent Mode."
        )
        UI.success("Created IAP petchores.unlock.full. Set price (~4.99) and add a review screenshot in App Store Connect.")
      end
    rescue => e
      UI.important("Automatic IAP creation failed: #{e.message}")
      UI.important("Create it manually: App Store Connect -> Monetization -> In-App Purchases ->")
      UI.important("  Non-Consumable, Product ID petchores.unlock.full, Family Sharing ON, price ~4.99.")
    end
  end

  desc "Push metadata and screenshots only (no binary)"
  lane :meta do
    upload_to_app_store(
      skip_binary_upload: true,
      skip_screenshots: false,
      overwrite_screenshots: true,       # replace the App Store Connect set with this one
      submit_for_review: false,
      force: true,                       # do not open the HTML summary prompt
      precheck_include_in_app_purchases: false
    )
  end

  desc "Inspect the App Store Connect resources needed for submission (read-only)."
  lane :asc_inspect do
    jwt = asc_jwt
    app = APP_STORE_APP_ID

    code, info = asc_request(:get, "/v1/apps/#{app}/appInfos", jwt)
    UI.message("=== appInfos (#{code}) ===")
    puts JSON.pretty_generate(info)
    info_id = (info["data"] && info["data"].first && info["data"].first["id"]) rescue nil
    UI.message("appInfo id = #{info_id}")

    if info_id
      c, ard = asc_request(:get, "/v1/appInfos/#{info_id}/ageRatingDeclaration", jwt)
      UI.message("=== ageRatingDeclaration (#{c}) ===")
      puts JSON.pretty_generate(ard)
      c2, cat = asc_request(:get, "/v1/appInfos/#{info_id}?include=primaryCategory,secondaryCategory", jwt)
      UI.message("=== appInfo categories (#{c2}) ===")
      puts JSON.pretty_generate(cat)
    end

    c3, pub = asc_request(:get, "/v1/apps/#{app}/appDataUsagesPublishState", jwt)
    UI.message("=== appDataUsagesPublishState (#{c3}) ===")
    puts JSON.pretty_generate(pub)

    c4, du = asc_request(:get, "/v1/apps/#{app}/appDataUsages?limit=50", jwt)
    UI.message("=== appDataUsages (#{c4}) ===")
    puts JSON.pretty_generate(du)

    c5, iaps = asc_request(:get, "/v2/apps/#{app}/inAppPurchases?limit=50", jwt)
    UI.message("=== inAppPurchases v2 (#{c5}) ===")
    puts JSON.pretty_generate(iaps)
  end

  desc "Set the submission-required App Store Connect fields via the REST API: age " \
       "rating, category, the IAP, and probe App Privacy."
  lane :asc_prep do
    jwt = asc_jwt
    app = APP_STORE_APP_ID
    info_id = "edbf418d-20f0-433a-9143-f6e8339fa6dc"
    ard_id  = "edbf418d-20f0-433a-9143-f6e8339fa6dc"

    # 1. Age rating: nothing objectionable -> 4+. Frequency fields NONE, flags false.
    age_attrs = {
      "alcoholTobaccoOrDrugUseOrReferences" => "NONE",
      "contests" => "NONE",
      "gamblingSimulated" => "NONE",
      "gunsOrOtherWeapons" => "NONE",
      "medicalOrTreatmentInformation" => "NONE",
      "profanityOrCrudeHumor" => "NONE",
      "sexualContentGraphicAndNudity" => "NONE",
      "sexualContentOrNudity" => "NONE",
      "horrorOrFearThemes" => "NONE",
      "matureOrSuggestiveThemes" => "NONE",
      "violenceCartoonOrFantasy" => "NONE",
      "violenceRealisticProlongedGraphicOrSadistic" => "NONE",
      "violenceRealistic" => "NONE",
      "gambling" => false,
      "unrestrictedWebAccess" => false,
      "lootBox" => false,
      "messagingAndChat" => false,
      "userGeneratedContent" => false,
      "parentalControls" => false,
      "ageAssurance" => false,
      "advertising" => false,
      "healthOrWellnessTopics" => false,
      "kidsAgeBand" => nil
    }
    c, b = asc_request(:patch, "/v1/ageRatingDeclarations/#{ard_id}", jwt,
                       { "data" => { "type" => "ageRatingDeclarations", "id" => ard_id,
                                     "attributes" => age_attrs } })
    UI.message("age rating PATCH -> #{c}")
    puts b unless c.between?(200, 299)

    # 2. Category -> Education
    cc, cats = asc_request(:get, "/v1/appCategories?filter[platforms]=IOS&limit=100", jwt)
    edu = (cats["data"].find { |x| x["id"].to_s.casecmp("EDUCATION").zero? } rescue nil)
    UI.message("appCategories GET -> #{cc}; education id = #{edu && edu['id']}")
    if edu
      pc, pb = asc_request(:patch, "/v1/appInfos/#{info_id}", jwt,
                           { "data" => { "type" => "appInfos", "id" => info_id,
                             "relationships" => { "primaryCategory" =>
                               { "data" => { "type" => "appCategories", "id" => edu["id"] } } } } })
      UI.message("category PATCH -> #{pc}")
      puts pb unless pc.between?(200, 299)
    end

    # 3. IAP petchores.unlock.full (non-consumable, family sharable)
    ic, iaps = asc_request(:get, "/v1/apps/#{app}/inAppPurchasesV2?limit=50", jwt)
    UI.message("inAppPurchasesV2 GET -> #{ic}")
    have = (iaps["data"].any? { |p| p.dig("attributes", "productId") == "petchores.unlock.full" } rescue false)
    if have
      UI.message("IAP petchores.unlock.full already exists")
    else
      icr, ib = asc_request(:post, "/v2/inAppPurchases", jwt,
        { "data" => { "type" => "inAppPurchases",
          "attributes" => {
            "name" => "Pet Chores Full Unlock",
            "productId" => "petchores.unlock.full",
            "inAppPurchaseType" => "NON_CONSUMABLE",
            "reviewNote" => "Unlocks all pets, multiple pets at once, photo proof, and report export. Reachable only inside PIN-gated Parent Mode.",
            "familySharable" => true },
          "relationships" => { "app" => { "data" => { "type" => "apps", "id" => app } } } } })
      UI.message("IAP create -> #{icr}")
      puts ib
    end

    # 4. App Privacy discovery: is the privacy nutrition-label API reachable at all?
    [:get, "/v1/appDataUsageCategories?limit=5"].tap do |m, p|
      pc, pb = asc_request(m, p, jwt)
      UI.message("privacy: GET appDataUsageCategories -> #{pc}")
      puts JSON.pretty_generate(pb)
    end
    # Try creating the canonical "Data Not Collected" declaration directly.
    dc, db = asc_request(:post, "/v1/appDataUsages", jwt,
      { "data" => { "type" => "appDataUsages",
        "relationships" => { "app" => { "data" => { "type" => "apps", "id" => app } } } } })
    UI.message("privacy: POST appDataUsages (empty) -> #{dc}")
    puts JSON.pretty_generate(db)
  end

  desc "Show app store version state and clear any pending submission that locks editing."
  lane :unlock_shots do
    jwt = asc_jwt
    app = APP_STORE_APP_ID
    _, vers = asc_request(:get, "/v1/apps/#{app}/appStoreVersions?limit=5", jwt)
    (vers["data"] || []).each do |v|
      vid = v["id"]
      UI.message("version #{v.dig('attributes', 'versionString')} state=#{v.dig('attributes', 'appStoreState')} id=#{vid}")
      _, sub = asc_request(:get, "/v1/appStoreVersions/#{vid}/appStoreVersionSubmission", jwt)
      sid = sub.dig("data", "id")
      if sid
        dc, _ = asc_request(:delete, "/v1/appStoreVersionSubmissions/#{sid}", jwt)
        UI.message("  cleared submission #{sid} -> #{dc}")
      else
        UI.message("  no pending submission")
      end
    end
  end

  desc "Set up an external TestFlight group with a PUBLIC LINK, attach the latest build, " \
       "and submit it for Beta App Review. Prints the shareable link."
  lane :tf_link do
    jwt = asc_jwt
    app = APP_STORE_APP_ID

    # 1. Latest build + processing state.
    _, builds = asc_request(:get, "/v1/builds?filter[app]=#{app}&sort=-version&limit=5", jwt)
    build = (builds["data"] || []).first
    build_id = build && build["id"]
    UI.message("latest build #{build && build.dig('attributes', 'version')} id=#{build_id} state=#{build && build.dig('attributes', 'processingState')}")
    next if build_id.nil?

    # 2. Beta App Review contact detail (required to submit for external review).
    _, detail = asc_request(:get, "/v1/apps/#{app}/betaAppReviewDetail", jwt)
    detail_id = detail.dig("data", "id")
    if detail_id
      dc, db = asc_request(:patch, "/v1/betaAppReviewDetails/#{detail_id}", jwt,
        { "data" => { "type" => "betaAppReviewDetails", "id" => detail_id,
          "attributes" => {
            "contactFirstName" => "Mark", "contactLastName" => "Gabrielli",
            "contactEmail" => "info@wetyr.com", "contactPhone" => "+13865550100",
            "demoAccountRequired" => false,
            "notes" => "No account needed. On launch: set a child name and a 4-digit PIN, pick a pet, tap Start Training to begin the 3-day free trial. Parent Mode is the Grown-ups button on Home (enter the PIN you set)." } } })
      UI.message("beta review detail -> #{dc}")
      puts db unless dc.between?(200, 299)
    end

    # 2b. Beta App Description + feedback email (required for external review).
    _, balocs = asc_request(:get, "/v1/apps/#{app}/betaAppLocalizations?limit=10", jwt)
    unless ((balocs["data"] || []).any? { |l| l.dig("attributes", "locale") == "en-US" } rescue false)
      ac, ab = asc_request(:post, "/v1/betaAppLocalizations", jwt,
        { "data" => { "type" => "betaAppLocalizations",
          "attributes" => { "locale" => "en-US",
            "description" => "Pet Chores is a kid trainer disguised as a pet-care game. Children practice the real daily care of a chosen animal on a real schedule, with real costs, and earn a parent readiness verdict before a real pet ever comes home.",
            "feedbackEmail" => "info@wetyr.com",
            "marketingUrl" => "https://markcmo.com",
            "privacyPolicyUrl" => "https://markcmo.com" },
          "relationships" => { "app" => { "data" => { "type" => "apps", "id" => app } } } } })
      UI.message("beta app localization -> #{ac}")
      puts ab unless ac.between?(200, 299)
    end

    # 3. "What to test" localization for the build.
    _, locs = asc_request(:get, "/v1/builds/#{build_id}/betaBuildLocalizations?limit=10", jwt)
    unless ((locs["data"] || []).any? rescue false)
      lc, lb = asc_request(:post, "/v1/betaBuildLocalizations", jwt,
        { "data" => { "type" => "betaBuildLocalizations",
          "attributes" => { "locale" => "en-US",
            "whatsNew" => "Try the 3-day free trial: onboard, pick a pet, tap Start Training. Test the weekly/monthly/unlimited plans. Parent Mode is the Grown-ups button on Home." },
          "relationships" => { "build" => { "data" => { "type" => "builds", "id" => build_id } } } } })
      UI.message("build localization -> #{lc}")
      puts lb unless lc.between?(200, 299)
    end

    # 4. External group with a public link.
    _, groups = asc_request(:get, "/v1/apps/#{app}/betaGroups?limit=50", jwt)
    grp = ((groups["data"] || []).find { |g| g.dig("attributes", "name") == "Public Beta" } rescue nil)
    grp_id = grp && grp["id"]
    if grp_id.nil?
      gc, gb = asc_request(:post, "/v1/betaGroups", jwt,
        { "data" => { "type" => "betaGroups",
          "attributes" => { "name" => "Public Beta", "publicLinkEnabled" => true },
          "relationships" => { "app" => { "data" => { "type" => "apps", "id" => app } } } } })
      UI.message("create group -> #{gc}")
      puts gb unless gc.between?(200, 299)
      grp = gb["data"]
      grp_id = grp && grp["id"]
    end

    # 5. Attach the build to the group.
    bc, bb = asc_request(:post, "/v1/betaGroups/#{grp_id}/relationships/builds", jwt,
      { "data" => [{ "type" => "builds", "id" => build_id }] })
    UI.message("attach build -> #{bc}")
    puts bb unless bc.between?(200, 299)

    # 6. Submit the build for Beta App Review (required before the public link works).
    sc, sb = asc_request(:post, "/v1/betaAppReviewSubmissions", jwt,
      { "data" => { "type" => "betaAppReviewSubmissions",
        "relationships" => { "build" => { "data" => { "type" => "builds", "id" => build_id } } } } })
    UI.message("beta review submit -> #{sc}")
    puts sb unless sc.between?(200, 299)

    # 7. Read back the public link.
    _, g2 = asc_request(:get, "/v1/betaGroups/#{grp_id}", jwt)
    link = g2.dig("data", "attributes", "publicLink")
    UI.success("TestFlight public link: #{link.inspect}")
  end

  desc "Create the auto-renewable subscription group + plans (weekly/monthly/unlimited) " \
       "with prices and the 3-day free trial, via the App Store Connect API. Idempotent."
  lane :asc_subs do
    jwt = asc_jwt
    app = APP_STORE_APP_ID

    # 1. Find or create the subscription group.
    _, groups = asc_request(:get, "/v1/apps/#{app}/subscriptionGroups?limit=50", jwt)
    group = ((groups["data"] || []).find { |g| g.dig("attributes", "referenceName") == "Pet Care Plans" } rescue nil)
    group_id = group && group["id"]
    if group_id.nil?
      code, body = asc_request(:post, "/v1/subscriptionGroups", jwt,
        { "data" => { "type" => "subscriptionGroups",
          "attributes" => { "referenceName" => "Pet Care Plans" },
          "relationships" => { "app" => { "data" => { "type" => "apps", "id" => app } } } } })
      UI.message("create group -> #{code}")
      puts body unless code.between?(200, 299)
      group_id = body.dig("data", "id")
    end
    UI.message("subscription group id = #{group_id}")
    next if group_id.nil?

    _, subs = asc_request(:get, "/v1/subscriptionGroups/#{group_id}/subscriptions?limit=50", jwt)
    existing = {}
    (subs["data"] || []).each { |s| existing[s.dig("attributes", "productId")] = s["id"] }

    plans = [
      { pid: "petchores.weekly",  name: "One Pet Weekly",  period: "ONE_WEEK",  level: 2, price: "1.99",  family: false, trial: true,
        desc: "One pet at a time, billed weekly." },
      { pid: "petchores.monthly", name: "One Pet Monthly", period: "ONE_MONTH", level: 2, price: "4.99",  family: false, trial: true,
        desc: "One pet at a time, billed monthly." },
      { pid: "petchores.unlimited", name: "Unlimited Pets", period: "ONE_MONTH", level: 1, price: "19.99", family: true, trial: false,
        desc: "Train as many pets at once as you like." }
    ]

    plans.each do |p|
      sub_id = existing[p[:pid]]
      if sub_id.nil?
        code, body = asc_request(:post, "/v1/subscriptions", jwt,
          { "data" => { "type" => "subscriptions",
            "attributes" => { "name" => p[:name], "productId" => p[:pid],
              "subscriptionPeriod" => p[:period], "familySharable" => p[:family], "groupLevel" => p[:level] },
            "relationships" => { "group" => { "data" => { "type" => "subscriptionGroups", "id" => group_id } } } } })
        UI.message("create sub #{p[:pid]} -> #{code}")
        puts body unless code.between?(200, 299)
        sub_id = body.dig("data", "id")
      else
        UI.message("sub #{p[:pid]} exists (#{sub_id})")
      end
      next if sub_id.nil?

      # Localization (en-US).
      _, locs = asc_request(:get, "/v1/subscriptions/#{sub_id}/subscriptionLocalizations?limit=10", jwt)
      unless ((locs["data"] || []).any? { |l| l.dig("attributes", "locale") == "en-US" } rescue false)
        code, body = asc_request(:post, "/v1/subscriptionLocalizations", jwt,
          { "data" => { "type" => "subscriptionLocalizations",
            "attributes" => { "name" => p[:name], "locale" => "en-US", "description" => p[:desc] },
            "relationships" => { "subscription" => { "data" => { "type" => "subscriptions", "id" => sub_id } } } } })
        UI.message("  localization -> #{code}")
        puts body unless code.between?(200, 299)
      end

      # Availability MUST be set before prices or offers can be attached.
      ac, avail = asc_request(:get, "/v1/subscriptions/#{sub_id}/subscriptionAvailability", jwt)
      has_avail = (ac.between?(200, 299) && !avail["data"].nil?)
      unless has_avail
        code, body = asc_request(:post, "/v1/subscriptionAvailabilities", jwt,
          { "data" => { "type" => "subscriptionAvailabilities",
            "attributes" => { "availableInNewTerritories" => true },
            "relationships" => {
              "subscription" => { "data" => { "type" => "subscriptions", "id" => sub_id } },
              "availableTerritories" => { "data" => [{ "type" => "territories", "id" => "USA" }] } } } })
        UI.message("  availability -> #{code}")
        puts body unless code.between?(200, 299)
      end

      # Price (USA price point matching the target).
      _, prices = asc_request(:get, "/v1/subscriptions/#{sub_id}/prices?limit=50", jwt)
      unless ((prices["data"] || []).any? rescue false)
        _, pps = asc_request(:get, "/v1/subscriptions/#{sub_id}/pricePoints?filter[territory]=USA&limit=200", jwt)
        list = pps["data"] || []
        pp = (list.find { |x| x.dig("attributes", "customerPrice") == p[:price] } rescue nil)
        UI.message("  USA price points: #{list.count}; sample: #{list.first(3).map { |x| x.dig('attributes','customerPrice') }.inspect}; matched id=#{pp && pp['id']}")
        if pp
          code, body = asc_request(:post, "/v1/subscriptionPrices", jwt,
            { "data" => { "type" => "subscriptionPrices",
              "relationships" => {
                "subscription" => { "data" => { "type" => "subscriptions", "id" => sub_id } },
                "subscriptionPricePoint" => { "data" => { "type" => "subscriptionPricePoints", "id" => pp["id"] } } } } })
          UI.message("  price #{p[:price]} -> #{code}")
          puts body unless code.between?(200, 299)
        else
          UI.important("  no USA price point matching #{p[:price]} for #{p[:pid]}")
        end
      end

      # 3-day free trial introductory offer (weekly / monthly), USA territory.
      if p[:trial]
        _, offers = asc_request(:get, "/v1/subscriptions/#{sub_id}/introductoryOffers?limit=10", jwt)
        unless ((offers["data"] || []).any? rescue false)
          code, body = asc_request(:post, "/v1/subscriptionIntroductoryOffers", jwt,
            { "data" => { "type" => "subscriptionIntroductoryOffers",
              "attributes" => { "duration" => "THREE_DAYS", "offerMode" => "FREE_TRIAL", "numberOfPeriods" => 1 },
              "relationships" => {
                "subscription" => { "data" => { "type" => "subscriptions", "id" => sub_id } },
                "territory" => { "data" => { "type" => "territories", "id" => "USA" } } } } })
          UI.message("  free trial -> #{code}")
          puts body unless code.between?(200, 299)
        end
      end
    end
  end

  desc "Capture App Store screenshots on the CI simulators via the -uitestSeed demo " \
       "state. Outputs to fastlane/screenshots/<locale>/ (uploaded as a CI artifact)."
  lane :screenshots do
    gen
    capture_screenshots(project: "./PetChores.xcodeproj")
  end

  desc "Add device frames, captions, and the paw background to raw screenshots in " \
       "fastlane/screenshots/<locale>/. Outputs *_framed.png that deliver then uploads."
  lane :frames do
    frame_screenshots(path: "./fastlane/screenshots")
  end

  MATCH_GIT_URL = "git@github.com:MarkCMO/markcmo-ios-certs.git".freeze
  APP_ID = "com.petchores.app".freeze

  # One-time: free a distribution-certificate slot, then generate the App Store
  # signing identity (distribution cert + profile) and store it encrypted via match.
  # An Apple account allows only 2 distribution certs; an earlier CI run created one
  # (R48V36LMP5) whose private key lived on an ephemeral runner and is gone, so it is
  # dead weight occupying a slot. Revoke just that one (never the EAS cert in use by
  # WETYR Films), then let match create and persist a reusable identity.
  lane :certs do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(
      hash: {
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key: File.read(ENV["ASC_KEY_PATH"])
      }
    )
    begin
      orphan = Spaceship::ConnectAPI::Certificate.all.find { |c| c.id == "R48V36LMP5" }
      if orphan
        orphan.delete!
        UI.success("Revoked orphaned distribution certificate R48V36LMP5")
      else
        UI.message("Orphan cert R48V36LMP5 not present; nothing to revoke")
      end
    rescue => e
      UI.important("Could not revoke R48V36LMP5: #{e.message}")
    end

    match(
      type: "appstore",
      app_identifier: APP_ID,
      git_url: MATCH_GIT_URL,
      storage_mode: "git",
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      team_id: ENV["TEAM_ID"],
      readonly: false
    )
  end

  # Shared build step. Pulls the persisted signing identity from match (read-only),
  # then builds with manual App Store signing. Run the `certs` lane once first.
  private_lane :build_ios do
    gen
    team = ENV["TEAM_ID"]
    # Each App Store Connect upload needs a unique, increasing build number. The CI run
    # number is monotonic, so use it (fallback 1 for local runs).
    build_num = ENV["GITHUB_RUN_NUMBER"].to_s.empty? ? "1" : ENV["GITHUB_RUN_NUMBER"]

    match(
      type: "appstore",
      app_identifier: APP_ID,
      git_url: MATCH_GIT_URL,
      storage_mode: "git",
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      team_id: team,
      readonly: true
    )
    profile = ENV["sigh_#{APP_ID}_appstore_profile-name"]

    build_app(
      scheme: "PetChores",
      export_method: "app-store",
      # Empty formatter = raw xcodebuild output, so Swift compile errors are visible
      # in the CI log (xcbeautify hides them). Revert to a formatter once it builds.
      xcodebuild_formatter: "",
      xcargs: "DEVELOPMENT_TEAM=#{team} CODE_SIGN_STYLE=Manual " \
              "CODE_SIGN_IDENTITY='Apple Distribution' " \
              "CURRENT_PROJECT_VERSION=#{build_num} " \
              "PROVISIONING_PROFILE_SPECIFIER='#{profile}'",
      export_options: {
        teamID: team,
        signingStyle: "manual",
        provisioningProfiles: { APP_ID => profile }
      }
    )
  end

  desc "Run the unit-test suite (pure logic: scoring, schedule, budget, consequences)."
  lane :tests do
    gen
    run_tests(
      project: "./PetChores.xcodeproj",
      scheme: "PetChores",
      devices: ["iPhone 17 Pro Max"],
      only_testing: ["PetChoresTests"],
      xcodebuild_formatter: ""
    )
  end

  desc "Build and upload a build to TestFlight"
  lane :beta do
    build_ios
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc "Build, upload, set metadata, and submit for App Review"
  lane :release do
    build_ios
    upload_to_app_store(
      submit_for_review: true,
      automatic_release: true,
      force: true,
      # The IAP petchores.unlock.full exists but is intentionally left incomplete for
      # the first release (no price/screenshot yet); exclude it from precheck so it does
      # not block the app submission. Submit/complete the IAP in a later release.
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false     # no ad identifier; matches the privacy manifest
      }
    )
  end
end
