# Pet Chores release automation (run on a Mac with Xcode + fastlane installed).
#
# Authentication uses an App Store Connect API key (.p8). Create one at
# App Store Connect -> Users and Access -> Integrations -> App Store Connect API.
# Keep the .p8 file OFF git. Provide these env vars before running a lane:
#   ASC_KEY_ID      the key id, e.g. ABC123XYZ
#   ASC_ISSUER_ID   the issuer id (a UUID shown on the same page)
#   ASC_KEY_PATH    absolute path to AuthKey_ABC123XYZ.p8 on your Mac
#
# One-time prep on the Mac:
#   brew install fastlane xcodegen
#   cd PetChores && xcodegen generate   (creates PetChores.xcodeproj)
#   open the project once, set your signing Team, add the In-App Purchase capability.
#
# Then:
#   fastlane meta      push listing text + screenshots only (no build)
#   fastlane beta      build, sign, upload to TestFlight
#   fastlane release   build, sign, upload, set metadata, submit for review

default_platform(:ios)

require "net/http"
require "json"

APP_STORE_APP_ID = "6779748088".freeze

# Raw App Store Connect REST helpers, for the listing fields fastlane's high-level
# actions do not manage (App Privacy nutrition labels, age rating, category, IAP v2).
def asc_jwt
  require "spaceship"
  token = Spaceship::ConnectAPI::Token.from(
    hash: {
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key: File.read(ENV["ASC_KEY_PATH"])
    }
  )
  token.text
end

def asc_request(method, path, jwt, body = nil)
  uri = URI("https://api.appstoreconnect.apple.com#{path}")
  http = Net::HTTP.new(uri.host, 443)
  http.use_ssl = true
  klass = { get: Net::HTTP::Get, post: Net::HTTP::Post,
            patch: Net::HTTP::Patch, delete: Net::HTTP::Delete }[method]
  req = klass.new(uri)
  req["Authorization"] = "Bearer #{jwt}"
  req["Content-Type"] = "application/json"
  req.body = body.to_json if body
  res = http.request(req)
  parsed = (JSON.parse(res.body) rescue res.body)
  [res.code.to_i, parsed]
end

platform :ios do
  before_all do
    # On CI, create and unlock a dedicated temporary keychain and configure its
    # partition list, so codesign never blocks on a GUI keychain-access prompt
    # (which hangs the headless runner). No-op on a developer's own machine.
    setup_ci
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
      in_house: false
    )
  end

  desc "Regenerate the Xcode project from project.yml"
  lane :gen do
    sh("cd .. && xcodegen generate")
  end

  desc "One-time: create the app record on App Store Connect"
  lane :setup_app do
    # produce(...) only supports legacy Apple ID (username) login and cannot use an
    # App Store Connect API key, so it fails in headless CI. Create the records
    # directly through Spaceship::ConnectAPI instead (same token path as create_iap).
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(
      hash: {
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key: File.read(ENV["ASC_KEY_PATH"])
      }
    )

    identifier = "com.petchores.app"

    existing = Spaceship::ConnectAPI::App.find(identifier)
    if existing
      UI.success("App already exists on App Store Connect: #{identifier} (id #{existing.id})")
      next
    end

    bundle = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == identifier }
    if bundle.nil?
      bundle = Spaceship::ConnectAPI::BundleId.create(name: "Pet Chores", identifier: identifier)
      UI.success("Registered bundle id #{identifier}")
    else
      UI.success("Bundle id already registered: #{identifier}")
    end

    # The App Store Connect API does not permit creating the initial app record
    # ('apps' resource disallows CREATE). It must be created once in the App Store
    # Connect website. Everything else (IAP, build, TestFlight, metadata) then runs
    # through the API key. Fail loudly with instructions instead of erroring opaquely.
    UI.user_error!(
      "App record for #{identifier} does not exist yet. Create it once at " \
      "https://appstoreconnect.apple.com -> Apps -> New App: Platform iOS, name " \
      "'Pet Chores: Pet Care Practice', primary language English (U.S.), bundle id " \
      "#{identifier}, SKU petchores-001. Then re-run a lane (create_iap or beta)."
    )
  end

  desc "One-time best-effort: create the non-consumable IAP. If it errors, create it " \
       "manually in App Store Connect (Monetization -> In-App Purchases) with product " \
       "id petchores.unlock.full, type Non-Consumable, Family Sharing ON, price ~4.99."
  lane :create_iap do
    begin
      require "spaceship"
      Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(
        hash: {
          key_id: ENV["ASC_KEY_ID"],
          issuer_id: ENV["ASC_ISSUER_ID"],
          key: File.read(ENV["ASC_KEY_PATH"])
        }
      )
      app = Spaceship::ConnectAPI::App.find("com.petchores.app")
      raise "App record not found; run `fastlane setup_app` first." unless app

      existing = app.get_in_app_purchases.find { |p| p.product_id == "petchores.unlock.full" }
      if existing
        UI.success("IAP already exists: petchores.unlock.full")
      else
        app.create_in_app_purchase(
          name: "Pet Chores Full Unlock",
          product_id: "petchores.unlock.full",
          in_app_purchase_type: "NON_CONSUMABLE",
          family_sharable: true,
          review_note: "Unlocks all pets, multiple pets at once, photo proof, and report export. Reachable only inside PIN-gated Parent Mode."
        )
        UI.success("Created IAP petchores.unlock.full. Set price (~4.99) and add a review screenshot in App Store Connect.")
      end
    rescue => e
      UI.important("Automatic IAP creation failed: #{e.message}")
      UI.important("Create it manually: App Store Connect -> Monetization -> In-App Purchases ->")
      UI.important("  Non-Consumable, Product ID petchores.unlock.full, Family Sharing ON, price ~4.99.")
    end
  end

  desc "Push metadata and screenshots only (no binary)"
  lane :meta do
    upload_to_app_store(
      skip_binary_upload: true,
      skip_screenshots: false,
      submit_for_review: false,
      force: true,                       # do not open the HTML summary prompt
      precheck_include_in_app_purchases: false
    )
  end

  desc "Inspect the App Store Connect resources needed for submission (read-only)."
  lane :asc_inspect do
    jwt = asc_jwt
    app = APP_STORE_APP_ID

    code, info = asc_request(:get, "/v1/apps/#{app}/appInfos", jwt)
    UI.message("=== appInfos (#{code}) ===")
    puts JSON.pretty_generate(info)
    info_id = (info["data"] && info["data"].first && info["data"].first["id"]) rescue nil
    UI.message("appInfo id = #{info_id}")

    if info_id
      c, ard = asc_request(:get, "/v1/appInfos/#{info_id}/ageRatingDeclaration", jwt)
      UI.message("=== ageRatingDeclaration (#{c}) ===")
      puts JSON.pretty_generate(ard)
      c2, cat = asc_request(:get, "/v1/appInfos/#{info_id}?include=primaryCategory,secondaryCategory", jwt)
      UI.message("=== appInfo categories (#{c2}) ===")
      puts JSON.pretty_generate(cat)
    end

    c3, pub = asc_request(:get, "/v1/apps/#{app}/appDataUsagesPublishState", jwt)
    UI.message("=== appDataUsagesPublishState (#{c3}) ===")
    puts JSON.pretty_generate(pub)

    c4, du = asc_request(:get, "/v1/apps/#{app}/appDataUsages?limit=50", jwt)
    UI.message("=== appDataUsages (#{c4}) ===")
    puts JSON.pretty_generate(du)

    c5, iaps = asc_request(:get, "/v2/apps/#{app}/inAppPurchases?limit=50", jwt)
    UI.message("=== inAppPurchases v2 (#{c5}) ===")
    puts JSON.pretty_generate(iaps)
  end

  desc "Set the submission-required App Store Connect fields via the REST API: age " \
       "rating, category, the IAP, and probe App Privacy."
  lane :asc_prep do
    jwt = asc_jwt
    app = APP_STORE_APP_ID
    info_id = "edbf418d-20f0-433a-9143-f6e8339fa6dc"
    ard_id  = "edbf418d-20f0-433a-9143-f6e8339fa6dc"

    # 1. Age rating: nothing objectionable -> 4+. Frequency fields NONE, flags false.
    age_attrs = {
      "alcoholTobaccoOrDrugUseOrReferences" => "NONE",
      "contests" => "NONE",
      "gamblingSimulated" => "NONE",
      "gunsOrOtherWeapons" => "NONE",
      "healthOrWellnessTopics" => "NONE",
      "medicalOrTreatmentInformation" => "NONE",
      "profanityOrCrudeHumor" => "NONE",
      "sexualContentGraphicAndNudity" => "NONE",
      "sexualContentOrNudity" => "NONE",
      "horrorOrFearThemes" => "NONE",
      "matureOrSuggestiveThemes" => "NONE",
      "violenceCartoonOrFantasy" => "NONE",
      "violenceRealisticProlongedGraphicOrSadistic" => "NONE",
      "violenceRealistic" => "NONE",
      "gambling" => false,
      "unrestrictedWebAccess" => false,
      "lootBox" => false,
      "messagingAndChat" => false,
      "userGeneratedContent" => false,
      "parentalControls" => false,
      "ageAssurance" => false,
      "advertising" => false,
      "kidsAgeBand" => nil
    }
    c, b = asc_request(:patch, "/v1/ageRatingDeclarations/#{ard_id}", jwt,
                       { "data" => { "type" => "ageRatingDeclarations", "id" => ard_id,
                                     "attributes" => age_attrs } })
    UI.message("age rating PATCH -> #{c}")
    puts b unless c.between?(200, 299)

    # 2. Category -> Education
    cc, cats = asc_request(:get, "/v1/appCategories?filter[platforms]=IOS&limit=100", jwt)
    edu = (cats["data"].find { |x| x["id"].to_s.casecmp("EDUCATION").zero? } rescue nil)
    UI.message("appCategories GET -> #{cc}; education id = #{edu && edu['id']}")
    if edu
      pc, pb = asc_request(:patch, "/v1/appInfos/#{info_id}", jwt,
                           { "data" => { "type" => "appInfos", "id" => info_id,
                             "relationships" => { "primaryCategory" =>
                               { "data" => { "type" => "appCategories", "id" => edu["id"] } } } } })
      UI.message("category PATCH -> #{pc}")
      puts pb unless pc.between?(200, 299)
    end

    # 3. IAP petchores.unlock.full (non-consumable, family sharable)
    ic, iaps = asc_request(:get, "/v1/apps/#{app}/inAppPurchasesV2?limit=50", jwt)
    UI.message("inAppPurchasesV2 GET -> #{ic}")
    have = (iaps["data"].any? { |p| p.dig("attributes", "productId") == "petchores.unlock.full" } rescue false)
    if have
      UI.message("IAP petchores.unlock.full already exists")
    else
      icr, ib = asc_request(:post, "/v2/inAppPurchases", jwt,
        { "data" => { "type" => "inAppPurchases",
          "attributes" => {
            "name" => "Pet Chores Full Unlock",
            "productId" => "petchores.unlock.full",
            "inAppPurchaseType" => "NON_CONSUMABLE",
            "reviewNote" => "Unlocks all pets, multiple pets at once, photo proof, and report export. Reachable only inside PIN-gated Parent Mode.",
            "familySharable" => true },
          "relationships" => { "app" => { "data" => { "type" => "apps", "id" => app } } } } })
      UI.message("IAP create -> #{icr}")
      puts ib
    end

    # 4. App Privacy: probe endpoints to learn the correct path for "Data Not Collected"
    ["/v1/apps/#{app}/appDataUsagesPublishState",
     "/v1/appDataUsagesPublishStates/#{app}",
     "/v1/apps/#{app}?include=appDataUsagesPublishState"].each do |p|
      pc, pb = asc_request(:get, p, jwt)
      UI.message("privacy probe #{p} -> #{pc}")
      puts JSON.pretty_generate(pb) if pc.between?(200, 299)
    end
  end

  desc "Capture App Store screenshots on the CI simulators via the -uitestSeed demo " \
       "state. Outputs to fastlane/screenshots/<locale>/ (uploaded as a CI artifact)."
  lane :screenshots do
    gen
    capture_screenshots(project: "./PetChores.xcodeproj")
  end

  desc "Add device frames, captions, and the paw background to raw screenshots in " \
       "fastlane/screenshots/<locale>/. Outputs *_framed.png that deliver then uploads."
  lane :frames do
    frame_screenshots(path: "./fastlane/screenshots")
  end

  MATCH_GIT_URL = "git@github.com:MarkCMO/markcmo-ios-certs.git".freeze
  APP_ID = "com.petchores.app".freeze

  # One-time: free a distribution-certificate slot, then generate the App Store
  # signing identity (distribution cert + profile) and store it encrypted via match.
  # An Apple account allows only 2 distribution certs; an earlier CI run created one
  # (R48V36LMP5) whose private key lived on an ephemeral runner and is gone, so it is
  # dead weight occupying a slot. Revoke just that one (never the EAS cert in use by
  # WETYR Films), then let match create and persist a reusable identity.
  lane :certs do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(
      hash: {
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key: File.read(ENV["ASC_KEY_PATH"])
      }
    )
    begin
      orphan = Spaceship::ConnectAPI::Certificate.all.find { |c| c.id == "R48V36LMP5" }
      if orphan
        orphan.delete!
        UI.success("Revoked orphaned distribution certificate R48V36LMP5")
      else
        UI.message("Orphan cert R48V36LMP5 not present; nothing to revoke")
      end
    rescue => e
      UI.important("Could not revoke R48V36LMP5: #{e.message}")
    end

    match(
      type: "appstore",
      app_identifier: APP_ID,
      git_url: MATCH_GIT_URL,
      storage_mode: "git",
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      team_id: ENV["TEAM_ID"],
      readonly: false
    )
  end

  # Shared build step. Pulls the persisted signing identity from match (read-only),
  # then builds with manual App Store signing. Run the `certs` lane once first.
  private_lane :build_ios do
    gen
    team = ENV["TEAM_ID"]

    match(
      type: "appstore",
      app_identifier: APP_ID,
      git_url: MATCH_GIT_URL,
      storage_mode: "git",
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      team_id: team,
      readonly: true
    )
    profile = ENV["sigh_#{APP_ID}_appstore_profile-name"]

    build_app(
      scheme: "PetChores",
      export_method: "app-store",
      # Empty formatter = raw xcodebuild output, so Swift compile errors are visible
      # in the CI log (xcbeautify hides them). Revert to a formatter once it builds.
      xcodebuild_formatter: "",
      xcargs: "DEVELOPMENT_TEAM=#{team} CODE_SIGN_STYLE=Manual " \
              "CODE_SIGN_IDENTITY='Apple Distribution' " \
              "PROVISIONING_PROFILE_SPECIFIER='#{profile}'",
      export_options: {
        teamID: team,
        signingStyle: "manual",
        provisioningProfiles: { APP_ID => profile }
      }
    )
  end

  desc "Build and upload a build to TestFlight"
  lane :beta do
    build_ios
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc "Build, upload, set metadata, and submit for App Review"
  lane :release do
    build_ios
    upload_to_app_store(
      submit_for_review: true,
      automatic_release: true,
      force: true,
      precheck_include_in_app_purchases: true,
      submission_information: {
        add_id_info_uses_idfa: false     # no ad identifier; matches the privacy manifest
      }
    )
  end
end
